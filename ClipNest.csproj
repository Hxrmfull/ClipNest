<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Two editions from one source: with OCR (finds secrets on images; the Windows SDK projection adds ~25 MB)
         and without (-p:ClipNestOcr=false). Both read and write the same data. -->
    <ClipNestOcr Condition="'$(ClipNestOcr)' == ''">true</ClipNestOcr>
    <TargetFramework Condition="'$(ClipNestOcr)' == 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(ClipNestOcr)' != 'true'">net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion Condition="'$(ClipNestOcr)' == 'true'">10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants Condition="'$(ClipNestOcr)' == 'true'">$(DefineConstants);OCR</DefineConstants>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClipNest</AssemblyName>
    <RootNamespace>ClipNest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\clipnest.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>ClipNest</Product>
    <Description>Менеджер буфера обмена без лимитов</Description>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- precompiled code: no JIT pause on the first Win+V after startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite with page-level encryption (SQLCipher): the whole history.db is encrypted at rest -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\clipnest.ico" />
  </ItemGroup>

</Project>
