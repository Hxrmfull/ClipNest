<Window x:Class="ClipNest.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipNest"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/clipnest.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/clipnest.ico" Width="40" Height="40" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{DynamicResource s.InstallTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource s.InstallText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="Folder" FontSize="12" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="KeepButton" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.InstallKeep}" Click="Keep_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource s.InstallYes}" Click="Install_Click" IsDefault="True"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
