<Window x:Class="ClipNest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipNest — настройки"
        Width="560" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/clipnest.ico">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,18,4">
            <StackPanel Margin="0,0,6,0">

                <StackPanel Orientation="Horizontal" Margin="2,0,0,22">
                    <Image Source="pack://application:,,,/Assets/clipnest.ico" Width="40" Height="40"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ClipNest" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="История буфера обмена без ограничений" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Общие" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ReplaceWinV" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Открывать по Win+V"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Вместо встроенного буфера обмена Windows."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="Autostart" Style="{StaticResource Switch}" Margin="0,10">
                            <TextBlock Text="Запускать вместе с Windows"/>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="MoveUsedToTop" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Поднимать вставленное наверх"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Часто используемые записи всегда под рукой."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тема" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Chip}" Content="Системная" Focusable="True"/>
                                <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Chip}" Content="Тёмная" Focusable="True"/>
                                <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Chip}" Content="Светлая" Margin="0" Focusable="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="История" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Сколько записей хранить"/>
                                <TextBlock Style="{StaticResource Hint}" Text="0 — без ограничений. Закреплённые не считаются и не удаляются."/>
                            </StackPanel>
                            <TextBox x:Name="MaxItems" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Сколько дней хранить"/>
                                <TextBlock Style="{StaticResource Hint}" Text="0 — бессрочно."/>
                            </StackPanel>
                            <TextBox x:Name="MaxAgeDays" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="SaveImages" Style="{StaticResource Switch}" Margin="0,10">
                            <TextBlock Text="Сохранять изображения"/>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Максимальный размер изображения, МБ"/>
                                <TextBlock Style="{StaticResource Hint}" Text="0 — без ограничений. У встроенного буфера Windows лимит 4 МБ."/>
                            </StackPanel>
                            <TextBox x:Name="MaxImageMb" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Конфиденциальность" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="HideSecrets" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Скрывать пароли и ключи"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Пароли, токены, ключи API и номера карт закрываются спойлером, как в Telegram, и шифруются на диске. Показать: значок глаза или Ctrl+H."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="ScanImages" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Искать секреты на картинках"/>
                                <TextBlock x:Name="ScanImagesHint" Style="{StaticResource Hint}"
                                           Text="Новые картинки читаются распознаванием текста, встроенным в Windows (на этом компьютере, без интернета). Найденные пароли, токены и номера карт размываются, картинка шифруется. Вставляется она без размытия."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="ClearSecrets" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Убирать вставленный секрет из буфера через минуту"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Как в менеджерах паролей. Если за это время вы скопировали что-то другое, буфер не трогается. В истории ClipNest секрет остаётся."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="RespectPrivacy" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="Не сохранять данные из менеджеров паролей"/>
                                <TextBlock Style="{StaticResource Hint}" Text="То, что они помечают как «не для истории». Если выключить, такие записи будут сохраняться скрытыми и зашифрованными."/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="Не записывать из программ"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Имя .exe, по одному в строке."/>
                            <TextBox x:Name="Excluded" Style="{StaticResource Field}" Margin="0,8,0,0" AcceptsReturn="True"
                                     Height="96" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Данные" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="Stats" Text="…"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Записи, картинки и настройки."/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Открыть папку"
                                    Click="OpenFolder_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Папка с данными"/>
                                <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock x:Name="DataHint" Style="{StaticResource Hint}"
                                           Text="История будет перенесена в новую папку, ClipNest перезапустится."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="ResetFolder" Style="{StaticResource SecondaryButton}" Content="По умолчанию"
                                        Click="ResetFolder_Click" Margin="0,0,8,0"
                                        ToolTip="Вернуть в Документы\ClipNest"/>
                                <Button x:Name="ChangeFolder" Style="{StaticResource SecondaryButton}" Content="Изменить…"
                                        Click="ChangeFolder_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Очистить историю"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Закреплённые записи останутся."/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Очистить…"
                                    Click="Clear_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,18">
                    <Run Text="Клавиши в окне истории: ↑↓ выбор, Enter вставить, Shift+Enter без форматирования, Ctrl+1…9 быстрая вставка, Ctrl+C только копировать, Ctrl+P закрепить, Ctrl+H показать или скрыть секрет, Del удалить, Tab фильтр, правый клик — преобразования текста."/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Отмена" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
