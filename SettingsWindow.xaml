<Window x:Class="ClipNest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource s.SettingsTitle}"
        Width="560" Height="720" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Assets/clipnest.ico">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Stroke}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,18,4">
            <StackPanel Margin="0,0,6,0">

                <StackPanel Orientation="Horizontal" Margin="2,0,0,22">
                    <Image Source="pack://application:,,,/Assets/clipnest.ico" Width="40" Height="40"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ClipNest" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource s.Tagline}" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{DynamicResource s.General}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ReplaceWinV" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.OpenWinV}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.OpenWinVHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="Autostart" Style="{StaticResource Switch}" Margin="0,10">
                            <TextBlock Text="{DynamicResource s.Autostart}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="MoveUsedToTop" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.MoveToTop}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.MoveToTopHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource s.Theme}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="theme" Style="{StaticResource Chip}" Content="{DynamicResource s.ThemeSystem}" Focusable="True"/>
                                <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Chip}" Content="{DynamicResource s.ThemeDark}" Focusable="True"/>
                                <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Chip}" Content="{DynamicResource s.ThemeLight}" Margin="0" Focusable="True"/>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource s.Language}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <!-- each language in its own name, so it is found whatever the interface speaks now -->
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <RadioButton x:Name="LangRu" GroupName="lang" Style="{StaticResource Chip}" Content="Русский" Focusable="True"/>
                                <RadioButton x:Name="LangEn" GroupName="lang" Style="{StaticResource Chip}" Content="English" Focusable="True"/>
                                <RadioButton x:Name="LangZh" GroupName="lang" Style="{StaticResource Chip}" Content="中文" Margin="0" Focusable="True"/>
                            </WrapPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <!-- stacked rather than label | control: reads well down to the window's minimum width -->
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="{DynamicResource s.PopupSize}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.PopupSizeHint}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <RadioButton x:Name="Size80" GroupName="size" Style="{StaticResource Chip}" Content="80%" Focusable="True"/>
                                <RadioButton x:Name="Size90" GroupName="size" Style="{StaticResource Chip}" Content="90%" Focusable="True"/>
                                <RadioButton x:Name="Size100" GroupName="size" Style="{StaticResource Chip}" Content="100%" Focusable="True"/>
                                <RadioButton x:Name="Size110" GroupName="size" Style="{StaticResource Chip}" Content="110%" Focusable="True"/>
                                <RadioButton x:Name="Size125" GroupName="size" Style="{StaticResource Chip}" Content="125%" Focusable="True"/>
                            </WrapPanel>
                            <TextBlock x:Name="SizeHint" Style="{StaticResource Hint}" Margin="0,12,0,0"
                                       Text="{DynamicResource s.SizeHintIdle}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="SizeByMouse" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.SizeByMouse}"
                                        Click="SizeByMouse_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ResetSize" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.SizeReset}"
                                        Click="ResetSize_Click" ToolTip="{DynamicResource s.SizeResetTip}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource s.HistorySection}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.MaxItems}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.MaxItemsHint}"/>
                            </StackPanel>
                            <TextBox x:Name="MaxItems" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.MaxDays}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.MaxDaysHint}"/>
                            </StackPanel>
                            <TextBox x:Name="MaxAgeDays" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="SaveImages" Style="{StaticResource Switch}" Margin="0,10">
                            <TextBlock Text="{DynamicResource s.SaveImages}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.MaxImage}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.MaxImageHint}"/>
                            </StackPanel>
                            <TextBox x:Name="MaxImageMb" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center"
                                     PreviewTextInput="Digits_PreviewTextInput"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource s.Privacy}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="HideSecrets" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.HideSecrets}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.HideSecretsHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="ScanImages" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.ScanImages}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ScanImagesHint" Style="{StaticResource Hint}"
                                           Text="{DynamicResource s.ScanImagesHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="ClearSecrets" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.ClearSecrets}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.ClearSecretsHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="RespectPrivacy" Style="{StaticResource Switch}" Margin="0,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.RespectPrivacy}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.RespectPrivacyHint}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="{DynamicResource s.Excluded}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.ExcludedHint}"/>
                            <TextBox x:Name="Excluded" Style="{StaticResource Field}" Margin="0,8,0,0" AcceptsReturn="True"
                                     Height="96" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource s.DataSection}" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="Stats" Text="…" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.StatsHint}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.OpenFolder}"
                                    Click="OpenFolder_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="{DynamicResource s.DataFolder}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock x:Name="DataHint" Style="{StaticResource Hint}"
                                       Text="{DynamicResource s.DataFolderHint}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ChangeFolder" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.ChangeFolder}"
                                        Click="ChangeFolder_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ResetFolder" Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.DefaultFolder}"
                                        Click="ResetFolder_Click" ToolTip="{DynamicResource s.DefaultFolderTip}"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource s.ClearHistory}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource s.ClearHistoryHint}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="{DynamicResource s.ClearButton}"
                                    Click="Clear_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,18">
                    <Run Text="{DynamicResource s.KeysHelp}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource s.Cancel}" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource s.Save}" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
