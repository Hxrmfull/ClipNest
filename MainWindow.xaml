<Window x:Class="ClipNest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:ClipNest.Models"
        xmlns:local="clr-namespace:ClipNest"
        Title="ClipNest"
        Width="420" Height="600"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- A normal (non-layered) window: Windows 11 draws the rounded corners, border and shadow itself.
         AllowsTransparency would copy every frame from the GPU back to the CPU. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="ClipTemplate" DataType="{x:Type m:ClipItem}">
            <Grid Margin="12,10,10,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,26,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="swatch" Width="18" Height="18" CornerRadius="4" Margin="0,1,9,0" VerticalAlignment="Top"
                            Background="{Binding ColorSwatch}" BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="text" Grid.Column="1" Text="{Binding Preview}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="78" FontSize="13" LineHeight="19.5"
                               Foreground="{DynamicResource TextPrimary}"
                               ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
                        <TextBlock.Resources>
                            <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                                <Setter Property="MaxWidth" Value="560"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxHeight="420" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBlock.Resources>
                    </TextBlock>
                    <!-- Telegram-style dust in the shape of made-up lines; the real text appears only once revealed -->
                    <local:SpoilerView x:Name="spoiler" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                                       Text="{Binding SpoilerText}" FontSize="13" LineHeight="19.5" MaxHeight="78"
                                       IsRevealed="{Binding Revealed}" Target="{Binding ElementName=text}"/>
                    <Border x:Name="imgHost" Grid.ColumnSpan="2" CornerRadius="8" HorizontalAlignment="Left"
                            Background="{DynamicResource Checker}" Visibility="Collapsed" Padding="0"
                            local:RoundedClip.Radius="8">
                        <Grid>
                            <Image x:Name="img" Source="{Binding DisplayThumbnail}" MaxHeight="150" Stretch="Uniform"
                                   StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"
                                   ToolTipService.InitialShowDelay="500">
                                <Image.ToolTip>
                                    <ToolTip>
                                        <Image Source="{Binding LargePreview, IsAsync=True}" MaxWidth="720" MaxHeight="520"
                                               Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"
                                               local:RoundedClip.Radius="6"/>
                                    </ToolTip>
                                </Image.ToolTip>
                            </Image>
                            <local:SpoilerView x:Name="imgDust" Visibility="Collapsed" IsRevealed="{Binding Revealed}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextTertiary}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="qk" Grid.Column="3" Style="{StaticResource KeyCap}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding QuickKey}"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="pinMark" Text="&#xE842;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource AccentText}" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,2,2,0" Visibility="Collapsed"/>

                <!-- spans both rows so it never adds to the height of a one-line card: shown on hover, it must not shift the layout -->
                <Border x:Name="actions" Grid.RowSpan="2" Background="{DynamicResource CardBg}" CornerRadius="7" BorderBrush="{DynamicResource Stroke}"
                        BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-4,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="eyeBtn" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12"
                                Content="&#xE890;" Click="Reveal_Click" ToolTip="{DynamicResource s.RevealTip}" Visibility="Collapsed"/>
                        <Button x:Name="pinBtn" Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12"
                                Content="&#xE718;" Click="Pin_Click" ToolTip="{DynamicResource s.PinTip}"/>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="26" FontSize="12"
                                Content="&#xE74D;" Click="Delete_Click" ToolTip="{DynamicResource s.DeleteTip}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Secret}" Value="True">
                    <Setter TargetName="spoiler" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="eyeBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- a whole secret image: blurred with dust over it. With found regions (OCR) the picture comes
                     pre-masked from DisplayThumbnail instead, the rest of it stays readable -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Secret}" Value="True"/>
                        <Condition Binding="{Binding HasRegions}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="imgDust" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="img" Property="Effect">
                        <Setter.Value>
                            <BlurEffect Radius="28"/>
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="img" Property="CacheMode">
                        <Setter.Value>
                            <BitmapCache/>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="img" Property="ToolTipService.IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter TargetName="text" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="spoiler" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="imgHost" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Revealed}" Value="True">
                    <Setter TargetName="eyeBtn" Property="Content" Value="&#xED1A;"/>
                    <Setter TargetName="eyeBtn" Property="ToolTip" Value="{DynamicResource s.HideTip}"/>
                    <!-- the text and the dust are animated by the SpoilerView: a circle growing from the mouse -->
                </DataTrigger>
                <!-- the blur animation only where there is a blur effect to animate -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Revealed}" Value="True"/>
                        <Condition Binding="{Binding HasRegions}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="img" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                 To="0" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="img" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)"
                                                 To="28" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasSwatch}" Value="True">
                    <Setter TargetName="swatch" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFiles}" Value="True">
                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource AccentText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding QuickKey}" Value="{x:Null}">
                    <Setter TargetName="qk" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="pinMark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="pinBtn" Property="Content" Value="&#xE77A;"/>
                    <Setter TargetName="pinBtn" Property="ToolTip" Value="{DynamicResource s.UnpinTip}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="pinMark" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
    <Border x:Name="Shell" Background="{DynamicResource SurfaceBg}" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Grid x:Name="Body">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentShift"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- grab strip: the window can be dragged by it (and by any empty spot outside the list) -->
            <Border x:Name="Grip" Height="20" Background="Transparent">
                <Border Width="36" Height="4" CornerRadius="2" Background="{DynamicResource StrokeStrong}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- search -->
            <Border x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,10" Background="{DynamicResource InputBg}" CornerRadius="8"
                    BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="10,0,4,0" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                 SelectionBrush="{DynamicResource Accent}" FontSize="14" VerticalContentAlignment="Center"
                                 TextChanged="Search_TextChanged" FocusVisualStyle="{x:Null}"/>
                        <TextBlock x:Name="Placeholder" Text="{DynamicResource s.Search}" Foreground="{DynamicResource TextTertiary}"
                                   FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <!-- shown while the popup works without focus: typing still lands here via the keyboard hook -->
                        <Rectangle x:Name="FakeCaret" Width="1.5" Height="18" Fill="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;"
                            FontSize="11" Width="26" Height="26" Click="ClearSearch_Click" ToolTip="{DynamicResource s.ClearTip}"
                            Visibility="Collapsed"/>
                    <Border x:Name="PausedBadge" Grid.Column="3" Background="{DynamicResource ChipBg}" CornerRadius="5"
                            Padding="7,2" Margin="6,0" VerticalAlignment="Center" Visibility="Collapsed"
                            ToolTip="{DynamicResource s.PausedTip}">
                        <TextBlock Text="{DynamicResource s.Paused}" FontSize="11" Foreground="{DynamicResource Danger}"/>
                    </Border>
                    <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE713;"
                            Click="Settings_Click" ToolTip="{DynamicResource s.SettingsTip}"/>
                </Grid>
            </Border>

            <!-- filters -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,0,12,10">
                <RadioButton x:Name="FAll" Style="{StaticResource Chip}" Content="{DynamicResource s.All}" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="FText" Style="{StaticResource Chip}" Content="{DynamicResource s.Text}" Checked="Filter_Checked"/>
                <RadioButton x:Name="FLinks" Style="{StaticResource Chip}" Content="{DynamicResource s.Links}" Checked="Filter_Checked"/>
                <RadioButton x:Name="FImages" Style="{StaticResource Chip}" Content="{DynamicResource s.Images}" Checked="Filter_Checked"/>
                <RadioButton x:Name="FFiles" Style="{StaticResource Chip}" Content="{DynamicResource s.Files}" Checked="Filter_Checked"/>
                <RadioButton x:Name="FPinned" Style="{StaticResource Chip}" Tag="&#xE718;" Checked="Filter_Checked"
                             ToolTip="{DynamicResource s.PinnedTip}"/>
            </StackPanel>

            <!-- history -->
            <ListBox x:Name="List" Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="12,0,4,4"
                     ItemContainerStyle="{StaticResource ClipItemStyle}" ItemTemplate="{StaticResource ClipTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0,1" VirtualizingPanel.CacheLengthUnit="Page"
                     Focusable="False" SelectionMode="Single"
                     PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                     ContextMenuOpening="List_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="ItemMenu" Closed="ItemMenu_Closed"/>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyState" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="30,0,30,40" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="EmptyGlyph" Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="34"
                           Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Text="{DynamicResource s.EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource s.EmptyText}" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- footer -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="14,8,12,9">
                <!-- on a narrow popup «Tab фильтр» makes way for the item count (FitFooter) -->
                <Grid x:Name="Footer" SizeChanged="Footer_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <StackPanel x:Name="FooterHints" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></Border>
                        <TextBlock Text="{DynamicResource s.HintPaste}" Margin="5,0,12,0"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift+Enter" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></Border>
                        <TextBlock Text="{DynamicResource s.HintPlain}" Margin="5,0,0,0"/>
                        <Border x:Name="TabKey" Style="{StaticResource KeyCap}" Margin="12,0,0,0"><TextBlock Text="Tab" FontSize="10" Foreground="{DynamicResource TextSecondary}"/></Border>
                        <TextBlock x:Name="TabHint" Text="{DynamicResource s.HintFilter}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <!-- sizing mode (Settings → «Изменить размер мышью»): outside the scaled shell, so the handles keep their size -->
    <Grid x:Name="SizingOverlay" Visibility="Collapsed" IsHitTestVisible="False">
        <Grid.Resources>
            <Style TargetType="Path">
                <Setter Property="Stroke" Value="{DynamicResource Accent}"/>
                <Setter Property="StrokeThickness" Value="3"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
        </Grid.Resources>
        <!-- the edges and corners themselves resize (real window borders in sizing mode, see SetResizable);
             the frame and the corner marks show it -->
        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"/>
        <Path Data="M1.5,13 L1.5,1.5 L13,1.5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Path Data="M0,1.5 L11.5,1.5 L11.5,13" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <Path Data="M1.5,0 L1.5,11.5 L13,11.5" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        <Path Data="M0,11.5 L11.5,11.5 L11.5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <!-- one compact strip over the search row: the cards and the footer stay in view while sizing -->
        <Border x:Name="SizingBanner" Background="{DynamicResource Accent}" CornerRadius="8" Padding="10,5,10,6" Margin="12,6,12,0" MinHeight="54"
                VerticalAlignment="Top">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SizeLabel" Foreground="White" FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource s.SizingHint}"
                           Foreground="White" Opacity="0.85" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,1,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
